console.log("INTERFACE CARREGOU");

let jogoAtual = null;
let jogoRodando = false;
let jogoPausado = false;

function mostrarTela(id) {
    document.querySelectorAll('.tela').forEach(t => t.classList.remove('ativa'));
    document.getElementById(id).classList.add('ativa');
}

function iniciarJogo(nome) {
    console.log("Iniciando:", nome);
    jogoAtual = nome;
    jogoRodando = true;
    jogoPausado = false;
    
    mostrarTela('tela-jogo');
    document.getElementById('painel-gameover').style.display = 'none';
    document.getElementById('btn-pausa').innerText = 'PAUSAR';
    
    const canvas = document.getElementById('canvas');
    const ctx = canvas.getContext('2d');
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    
    if (nome === 'snake' && window.initSnake) window.initSnake();
    if (nome === 'breakout' && window.initBreakout) window.initBreakout();
    if (nome === 'space' && window.initSpace) window.initSpace();
    if (nome === 'flap' && window.initFlap) window.initFlap();
    if (nome === 'blobby' && window.initBlobby) window.initBlobby();
}

function voltarMenu() {
    jogoRodando = false;
    jogoPausado = false;
    if (window.pararJogo) window.pararJogo();
    mostrarTela('tela-menu');
}

function alternarPausa() {
    if (!jogoRodando) return;
    jogoPausado = !jogoPausado;
    document.getElementById('btn-pausa').innerText = jogoPausado ? 'CONTINUAR' : 'PAUSAR';
    if (window.pausarJogo) window.pausarJogo(jogoPausado);
}

function reiniciarJogo() {
    if (jogoAtual) iniciarJogo(jogoAtual);
}

function mostrarGameOver(pontos) {
    jogoRodando = false;
    document.getElementById('score-final').innerText = `PONTUAÇÃO: ${pontos}`;
    document.getElementById('painel-gameover').style.display = 'block';
}

function atualizarPlacar(pontos, recorde) {
    document.getElementById('score-live').innerText = pontos;
    document.getElementById('record-live').innerText = `RECORDE: ${recorde}`;
}

// Loading inicial
window.addEventListener('load', () => {
    setTimeout(() => {
        mostrarTela('tela-menu');
    }, 1500);
});

// Botão instalar PWA
let deferredPrompt;
window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault();
    deferredPrompt = e;
    document.getElementById('btn-instalar').style.display = 'block';
});

document.getElementById('btn-instalar').addEventListener('click', async () => {
    if (deferredPrompt) {
        deferredPrompt.prompt();
        await deferredPrompt.userChoice;
        deferredPrompt = null;
    }
});